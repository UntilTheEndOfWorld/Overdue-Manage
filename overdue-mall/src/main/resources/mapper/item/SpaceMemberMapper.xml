<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.item.mapper.SpaceMemberMapper">

    <resultMap type="com.overdue.manager.item.domain.entity.SpaceMember" id="SpaceMemberResult">
        <result property="id" column="id"/>
        <result property="spaceId" column="space_id"/>
        <result property="userId" column="user_id"/>
        <result property="role" column="role"/>
        <result property="joinTime" column="join_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSpaceMemberVo">
        select id, space_id, user_id, role, join_time, status, create_time, update_time
        from overdue_space_member
    </sql>

    <select id="selectBySpaceId" resultMap="SpaceMemberResult">
        <include refid="selectSpaceMemberVo"/>
        where space_id = #{spaceId} and status = '0'
        order by join_time asc
    </select>

    <select id="selectBySpaceIdAndUserId" resultMap="SpaceMemberResult">
        <include refid="selectSpaceMemberVo"/>
        where space_id = #{spaceId} and user_id = #{userId} and status = '0'
        limit 1
    </select>

    <select id="selectSpaceMemberList" parameterType="com.overdue.manager.item.domain.entity.SpaceMember" resultMap="SpaceMemberResult">
        <include refid="selectSpaceMemberVo"/>
        <where>
            <if test="spaceId != null">
                and space_id = #{spaceId}
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="role != null and role != ''">
                and role = #{role}
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by join_time desc
    </select>
</mapper>
