<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.item.mapper.MemberOrderMapper">
    
    <resultMap type="com.overdue.manager.item.domain.entity.MemberOrder" id="MemberOrderResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="planType" column="plan_type"/>
        <result property="price" column="price"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentStatus" column="payment_status"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="transactionId" column="transaction_id"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectMemberOrderVo">
        select id, user_id, order_no, plan_type, price, payment_method, payment_status, payment_time, transaction_id, status, create_time, update_time from overdue_member_order
    </sql>

    <select id="selectMemberOrderList" parameterType="com.overdue.manager.item.domain.entity.MemberOrder" resultMap="MemberOrderResult">
        <include refid="selectMemberOrderVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="planType != null  and planType != ''"> and plan_type = #{planType}</if>
            <if test="paymentStatus != null  and paymentStatus != ''"> and payment_status = #{paymentStatus}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="MemberOrderResult">
        <include refid="selectMemberOrderVo"/>
        where user_id = #{userId}
        order by create_time desc
    </select>

    <select id="selectByOrderNo" parameterType="String" resultMap="MemberOrderResult">
        <include refid="selectMemberOrderVo"/>
        where order_no = #{orderNo}
        limit 1
    </select>

</mapper>
