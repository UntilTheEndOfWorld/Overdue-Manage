<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.item.mapper.SharedSpaceMapper">
    
    <resultMap type="com.overdue.manager.item.domain.entity.SharedSpace" id="SharedSpaceResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="creatorId" column="creator_id"/>
        <result property="inviteCode" column="invite_code"/>
        <result property="inviteCodeExpireTime" column="invite_code_expire_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectSharedSpaceVo">
        select id, name, description, creator_id, invite_code, invite_code_expire_time, status, create_time, update_time from overdue_shared_space
    </sql>

    <select id="selectSharedSpaceList" parameterType="com.overdue.manager.item.domain.entity.SharedSpace" resultMap="SharedSpaceResult">
        <include refid="selectSharedSpaceVo"/>
        <where>  
            <if test="name != null  and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="creatorId != null "> and creator_id = #{creatorId}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByInviteCode" parameterType="String" resultMap="SharedSpaceResult">
        <include refid="selectSharedSpaceVo"/>
        where invite_code = #{inviteCode} and status = '0'
        limit 1
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="SharedSpaceResult">
        select s.id, s.name, s.description, s.creator_id, s.invite_code, s.invite_code_expire_time, s.status, s.create_time, s.update_time
        from overdue_shared_space s
        inner join overdue_space_member m on s.id = m.space_id
        where m.user_id = #{userId} and m.status = '0' and s.status = '0'
        order by s.create_time desc
    </select>

</mapper>
