<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.item.mapper.OverdueMemberMapper">
    
    <resultMap type="com.overdue.manager.item.domain.entity.OverdueMember" id="OverdueMemberResult">
        <result property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="planType" column="plan_type"/>
        <result property="isMember" column="is_member"/>
        <result property="purchaseTime" column="purchase_time"/>
        <result property="expireTime" column="expire_time"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectOverdueMemberVo">
        select id, user_id, plan_type, is_member, purchase_time, expire_time, status, create_time, update_time from overdue_member
    </sql>

    <select id="selectOverdueMemberList" parameterType="com.overdue.manager.item.domain.entity.OverdueMember" resultMap="OverdueMemberResult">
        <include refid="selectOverdueMemberVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="planType != null  and planType != ''"> and plan_type = #{planType}</if>
            <if test="isMember != null "> and is_member = #{isMember}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="OverdueMemberResult">
        <include refid="selectOverdueMemberVo"/>
        where user_id = #{userId}
        limit 1
    </select>

</mapper>
