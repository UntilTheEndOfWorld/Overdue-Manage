<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.pms.mapper.PointsProductSkuMapper">
    
    <resultMap type="PointsProductSku" id="PointsProductSkuResult">
        <result property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="outSkuId" column="out_sku_id"/>
        <result property="points" column="points"/>
        <result property="originalPrice" column="original_price"/>
        <result property="pic" column="pic"/>
        <result property="spData" column="sp_data"/>
        <result property="stock" column="stock"/>
        <result property="exchangedCount" column="exchanged_count"/>
        <result property="exchangeLimit" column="exchange_limit"/>
        <result property="description" column="description"/>
        <result property="remark" column="remark"/>
        <result property="delFlag" column="del_flag"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectPointsProductSkuVo">
        select id, product_id, out_sku_id, points, original_price, pic, sp_data, stock, exchanged_count, exchange_limit, description, remark, del_flag, create_by, create_time, update_by, update_time from pms_points_product_sku
    </sql>

    <select id="selectByEntity" parameterType="PointsProductSku" resultMap="PointsProductSkuResult">
        <include refid="selectPointsProductSkuVo"/>
        <where>  
            <if test="productId != null "> and product_id = #{productId}</if>
            <if test="outSkuId != null  and outSkuId != ''"> and out_sku_id = #{outSkuId}</if>
            <if test="points != null "> and points = #{points}</if>
            <if test="originalPrice != null "> and original_price = #{originalPrice}</if>
            <if test="pic != null  and pic != ''"> and pic = #{pic}</if>
            <if test="spData != null  and spData != ''"> and sp_data = #{spData}</if>
            <if test="stock != null "> and stock = #{stock}</if>
            <if test="exchangedCount != null "> and exchanged_count = #{exchangedCount}</if>
            <if test="exchangeLimit != null "> and exchange_limit = #{exchangeLimit}</if>
            <if test="description != null  and description != ''"> and description like concat('%', #{description}, '%')</if>
        </where>
    </select>

    <!-- 更新库存 -->
    <update id="updateStockById">
        update pms_points_product_sku
        set stock = stock - #{quantity},
            update_time = #{optDate}
        where id = #{skuId}
          and stock >= #{quantity}
    </update>

    <!-- 增加兑换数量 -->
    <update id="increaseExchangedCount">
        update pms_points_product_sku
        set exchanged_count = exchanged_count + #{quantity},
            update_time = now()
        where id = #{skuId}
    </update>
</mapper>
