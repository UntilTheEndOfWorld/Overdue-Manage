<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.pms.mapper.MerchantCategoryMapper">
    
    <resultMap type="MerchantCategory" id="MerchantCategoryResult">
        <result property="id" column="id"/>
        <result property="categoryName" column="category_name"/>
        <result property="categoryCode" column="category_code"/>
        <result property="parentId" column="parent_id"/>
        <result property="level" column="level"/>
        <result property="sort" column="sort"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectMerchantCategoryVo">
        select id, category_name, category_code, parent_id, level, sort, status, create_by, create_time, update_by, update_time, del_flag from pms_merchant_category
    </sql>

    <select id="selectMerchantCategoryList" parameterType="MerchantCategory" resultMap="MerchantCategoryResult">
        <include refid="selectMerchantCategoryVo"/>
        <where>  
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="categoryCode != null  and categoryCode != ''"> and category_code = #{categoryCode}</if>
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="level != null "> and level = #{level}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="delFlag != null  and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
        order by sort asc, create_time desc
    </select>

    <select id="selectEnabledMerchantCategoryList" resultMap="MerchantCategoryResult">
        <include refid="selectMerchantCategoryVo"/>
        where status = 1 and del_flag = '0'
        order by sort asc, create_time desc
    </select>
    
    <select id="selectMerchantCategoryById" parameterType="Long" resultMap="MerchantCategoryResult">
        <include refid="selectMerchantCategoryVo"/>
        where id = #{id}
    </select>

    <select id="selectMerchantCategoryByCode" parameterType="String" resultMap="MerchantCategoryResult">
        <include refid="selectMerchantCategoryVo"/>
        where category_code = #{categoryCode} and del_flag = '0'
    </select>
        
    <insert id="insertMerchantCategory" parameterType="MerchantCategory" useGeneratedKeys="true" keyProperty="id">
        insert into pms_merchant_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryCode != null and categoryCode != ''">category_code,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="level != null">level,</if>
            <if test="sort != null">sort,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">#{categoryCode},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="level != null">#{level},</if>
            <if test="sort != null">#{sort},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateMerchantCategory" parameterType="MerchantCategory">
        update pms_merchant_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">category_code = #{categoryCode},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="level != null">level = #{level},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantCategoryById" parameterType="Long">
        update pms_merchant_category set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteMerchantCategoryByIds" parameterType="String">
        update pms_merchant_category set del_flag = '2' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
