<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.overdue.manager.pms.mapper.MerchantImageMapper">
    
    <resultMap type="MerchantImage" id="MerchantImageResult">
        <result property="id" column="id"/>
        <result property="merchantId" column="merchant_id"/>
        <result property="imageUrl" column="image_url"/>
        <result property="imageType" column="image_type"/>
        <result property="sort" column="sort"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="delFlag" column="del_flag"/>
    </resultMap>

    <sql id="selectMerchantImageVo">
        select id, merchant_id, image_url, image_type, sort, create_by, create_time, update_by, update_time, del_flag from pms_merchant_image
    </sql>

    <select id="selectMerchantImageList" parameterType="MerchantImage" resultMap="MerchantImageResult">
        <include refid="selectMerchantImageVo"/>
        <where>  
            <if test="merchantId != null "> and merchant_id = #{merchantId}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="imageType != null "> and image_type = #{imageType}</if>
            <if test="delFlag != null  and delFlag != ''"> and del_flag = #{delFlag}</if>
        </where>
        order by sort asc, create_time desc
    </select>

    <select id="selectMerchantImageListByMerchantId" parameterType="Long" resultMap="MerchantImageResult">
        <include refid="selectMerchantImageVo"/>
        where merchant_id = #{merchantId} and del_flag = '0'
        order by sort asc, create_time desc
    </select>
    
    <select id="selectMerchantImageById" parameterType="Long" resultMap="MerchantImageResult">
        <include refid="selectMerchantImageVo"/>
        where id = #{id}
    </select>
        
    <insert id="insertMerchantImage" parameterType="MerchantImage" useGeneratedKeys="true" keyProperty="id">
        insert into pms_merchant_image
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">merchant_id,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="imageType != null">image_type,</if>
            <if test="sort != null">sort,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="merchantId != null">#{merchantId},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="imageType != null">#{imageType},</if>
            <if test="sort != null">#{sort},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateMerchantImage" parameterType="MerchantImage">
        update pms_merchant_image
        <trim prefix="SET" suffixOverrides=",">
            <if test="merchantId != null">merchant_id = #{merchantId},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="imageType != null">image_type = #{imageType},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteMerchantImageById" parameterType="Long">
        update pms_merchant_image set del_flag = '2' where id = #{id}
    </delete>

    <delete id="deleteMerchantImageByIds" parameterType="String">
        update pms_merchant_image set del_flag = '2' where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteMerchantImageByMerchantId" parameterType="Long">
        update pms_merchant_image set del_flag = '2' where merchant_id = #{merchantId}
    </delete>
</mapper>
